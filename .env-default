# Defaults for UI-TARS (uitars_run + mm_agents.uitars15_v1).
# Copy and edit locally:  cp .env-default .env
# Loaded order: .env-default (defaults) then .env (overrides). .env is gitignored.

# OpenAI-compatible inference (vLLM, etc.). Comma-separated = pool; one is picked at random.
# dart-rollouter VM: vLLM listens on 8010. With SSH Host dart-rollouter, use LocalForward 8010 and point here.
OPENAI_BASE_URL=http://127.0.0.1:8010
OPENAI_API_KEY=empty

# Legacy CoAct args-mode fallback.
# `run_coact.py` now supports per-component config files; these env vars are only
# used as fallback defaults in args mode when explicit component settings are not provided.
# The GUI component in CoAct eval is computer-only.
OPENAI_CUA_MODEL=gpt-5.5

# Optional: enable orchestrator-side research tools by default in args mode.
# Can still be overridden with --enable_web_search.
# COACT_ENABLE_WEB_SEARCH=false

# Optional alias for the same base URL (if you prefer a UI-TARS-specific name).
# UITARS_OPENAI_BASE_URL=

# Desktop docker server (uitars_run)
OSWORLD_BASE_URL=http://127.0.0.1:50003
OSWORLD_TOKEN=dart

TOKENIZERS_PARALLELISM=false

# Optional: override proxy pool (otherwise defaults to dart_rollouter/.../webshare.secrets.txt or webshare.txt)
# PROXY_CONFIG_FILE=../dart_rollouter/evaluation_examples/settings/proxy/webshare.secrets.txt
